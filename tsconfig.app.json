{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* The app holds itself to the same bar it teaches. The Vite template ships
       without `strict`, which would be a strange thing to discover in a repo
       whose entire purpose is strict TypeScript. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /* These are source text for the in-browser compiler, imported with `?raw`.
     They are NOT part of this program: `node-stubs.d.ts` declares `node:path`
     and friends, and `assert.d.ts` declares Expect/Equal globally, so compiling
     them here would leak exercise scaffolding into the app's own namespace. */
  "exclude": ["src/engine/libs"]
}
